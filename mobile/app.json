{
  "expo": {
    "name": "Alfiya Kitchen",
    "slug": "alfiya-kitchen",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F8F6F1",
    "primaryColor": "#C99A4A",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8F6F1"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.alfiyakitchenrestaurant.app",
      "infoPlist": {
        "UIRequiresFullScreen": true
      }
    },
    "android": {
      "package": "com.alfiyakitchenrestaurant.app",
      "adaptiveIcon": {
        "backgroundColor": "#F8F6F1",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "permissions": []
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "restaurantName": "Alfiya Kitchen",
      "tagline": "Good Food. Great Moments.",
      "defaultApiUrl": "https://alfiya-kitchen.vercel.app"
    }
  }
}
